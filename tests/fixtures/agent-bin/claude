#!/bin/sh
# 51단계 e2e 가짜 claude — 받은 인자를 보이고, --settings 의 훅 명령을 실제 sh 로 부른다(JSON 을 stdin 으로).
# 실제 Claude 의 훅 순서 · 타이밍 · 신뢰 화면 · statusLine 은 흉내 내지 않는다.
# 입력 줄: perm(허락 기다림) · idle(입력 기다림) · go(작업 중) · done(턴 끝) · later(2초 뒤 턴 끝) · quit(세션 끝 뒤 종료)
#        · status 5h 7d(52단계: --settings 의 statusLine 명령을 rate_limits 입력으로 부르고 그 출력을 STATUS OUT: 뒤에 보인다)
settings=
for a in "$@"; do
  [ "$prev" = "--settings" ] && settings=$a
  prev=$a
done
echo "FAKE ARGS: $*"
hook=
[ -n "$settings" ] && hook=$(sed -n 's/^ *"command": "\(.*claude-hook\.sh.*\)",$/\1/p' "$settings" | head -n 1)
statusline=
[ -n "$settings" ] && statusline=$(sed -n 's/^ *"command": "\(.*claude-statusline\.sh.*\)",$/\1/p' "$settings" | head -n 1)
fire() {
  [ -n "$hook" ] || return 0
  printf '{"session_id":"s","hook_event_name":"%s","notification_type":"%s","prompt":"SECRET-PROMPT"}' "$1" "$2" | sh -c "$hook"
}
fire UserPromptSubmit
echo "FAKE READY"
while read -r line; do
  case "$line" in
    perm) fire PermissionRequest; echo "FAKE PERM" ;;
    idle) fire Notification idle_prompt; echo "FAKE IDLE" ;;
    go) fire PostToolUse; echo "FAKE GO" ;;
    done) fire Stop; echo "FAKE DONE" ;;
    later) (sleep 2; fire Stop) & echo "FAKE LATER" ;;
    quit) fire SessionEnd; echo "FAKE BYE"; exit 0 ;;
    status\ *)
      set -- $line
      now=$(date +%s)
      out=$(printf '{"session_id":"s","cwd":"/x","model":{"display_name":"Fake"},"rate_limits":{"five_hour":{"used_percentage":%s,"resets_at":%s},"seven_day":{"used_percentage":%s,"resets_at":%s}}}' "$2" $((now + 7200)) "$3" $((now + 259200)) | sh -c "$statusline")
      echo "STATUS OUT: [$out]" ;;
  esac
done
